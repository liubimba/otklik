{
	"name": "otklik",
	"version": "0.7.7",
	"description": "Otklik — automated job applications with AI cover letters",
	"homepage": "https://github.com/liubimba/otklik",
	"author": "liubimba",
	"packageManager": "pnpm@9.15.4",
	"type": "module",
	"main": "dist-electron/main.cjs",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"electron:compile": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
		"electron:dev": "pnpm electron:compile && electron --no-sandbox dist-electron/main.cjs",
		"electron:dist": "pnpm build && pnpm electron:compile && electron-builder",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test:unit:run": "vitest run",
		"machine-translate": "inlang machine translate --project project.inlang"
	},
	"license": "MIT",
	"dependencies": {
		"@dnd-kit/svelte": "^0.5.0",
		"@fontsource-variable/ibm-plex-sans": "^5.2.8",
		"@tanstack/svelte-query": "^6.1.34",
		"formsnap": "^2.0.1",
		"sveltekit-superforms": "^2.30.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@inlang/cli": "^3.0.0",
		"@inlang/paraglide-js": "^2.19.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.18.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22.19.21",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"electron": "^44.0.0",
		"electron-builder": "^26.15.3",
		"electron-log": "^5.4.4",
		"electron-updater": "^6.8.9",
		"esbuild": "^0.28.2",
		"jsdom": "^29.1.1",
		"mode-watcher": "^1.1.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.6.2",
		"vite": "^6.0.3",
		"vitest": "^2.1.0"
	}
}
